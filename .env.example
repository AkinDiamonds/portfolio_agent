# LLM Provider
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# Context Budget
# Total token window for model context.
MAX_CONTEXT_TOKENS=30000
# Tokens reserved for the model's response; effective input budget = MAX_CONTEXT_TOKENS - RESERVED_OUTPUT_TOKENS.
RESERVED_OUTPUT_TOKENS=1000

# GitHub
# Fine-grained PAT with public read access only — no elevated scope needed.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=github_pat_your-token-here

# Agent Behaviour
# Number of tool-call iterations allowed per user turn (1–10).
MAX_TOOL_ITERATIONS=4

# Networking
# CORS allowed origin — set to your real domain. NEVER use *.
ALLOWED_ORIGIN=https://your-portfolio-domain.com
# Set to false to disable per-IP rate limiting (not recommended in production).
RATE_LIMIT_ENABLED=true
# Maximum requests per minute per IP.
RATE_LIMIT_PER_MINUTE=20
